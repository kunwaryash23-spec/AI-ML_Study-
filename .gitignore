# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/
.python-version

# ---- Jupyter ----
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ---- Testing / type checking / linting caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ---- Editors / IDEs ----
.vscode/
.idea/
*.swp
*.swo

# ---- OS cruft ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Secrets ----
.env
.env.*
!.env.example
*.key
*.pem
api.txt
api_key*.txt
# any file with 'api' in the name (covers "gemini api.txt", "openai api key.txt", ...)
*api*.txt
*api*.json
*token*.txt
*_secret*
credentials.json

# ---- Downloaded archives ----
# Source archives you download to read/reference. Keep the extracted, useful
# files in the repo instead of the multi-MB zip. If you ever need to commit a
# specific archive, force it with: git add -f path/to/file.zip
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ---- Node / JS (video-search frontend) ----
node_modules/
dist/
*.tsbuildinfo

# ---- Vendored third-party source ----
# Reference code downloaded from elsewhere. Read it, learn from it, but it is
# not your work and it does not belong in your history. 60 MB of someone else's
# repo makes every future clone slower for no benefit.
impeccable-main/

# ---- Scratch / staging areas ----
# Anything you have already decided to throw away, plus editor backups made
# before a rewrite. If a "_to_delete" folder is still here next sync, delete it.
_to_delete/
*.original.ipynb
*.bak

# ---- Media samples ----
# Recordings streamed by the video-search backend. Regenerable, and large.
**/backend/media/*
!**/backend/media/README.md

# ---- Model / data artifacts (uncomment if these get large) ----
# *.h5
# *.pkl
# *.joblib
# *.ckpt

# ---- Vector store indexes ----
# Chroma writes an HNSW index + sqlite file to disk. It is a build artifact:
# re-running the ingest cell rebuilds it from the source PDF in seconds.
# Committing it means multi-MB binary diffs on every re-run.
chroma_db/
**/chroma_db/

# ---- Local scratch databases ----
# notes.db is the agent-memory sandbox from Day 34. It holds throwaway rows,
# and the schema is recreated by init_db() on import.
notes.db
**/notes.db

# ---- Personal documents ----
# CVs and resumes carry a phone number, email and address. This repo is a
# public study log, not a place to publish contact details. Keep them local.
# If you ever deliberately want one in here: git add -f "path/to/CV.pdf"
*CV*.pdf
*cv*.pdf
*[Rr]esume*.pdf
